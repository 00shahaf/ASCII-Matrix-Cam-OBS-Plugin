// ASCII Cam: turns the filtered source into ASCII art, blocks or Matrix rain.
// Every pixel works out which character cell it is in, averages the source over that
// cell (4x4 taps, grouped into quadrants for edge direction), picks a glyph and samples
// it from the atlas (see make_atlas.py for the layout).

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d atlas;

uniform float2 grid;            // columns, rows (fractional: the last cell may be partial)
uniform int mode;               // 0 ASCII, 1 blocks, 2 Matrix rain
uniform bool edges;
uniform float edge_threshold;
uniform bool source_colour;
uniform float4 tint;
uniform float4 bg;              // background colour, alpha = opacity
uniform float brightness;
uniform float contrast;
uniform float gamma;
uniform bool invert;
uniform float elapsed;          // seconds

#define GLYPHS 89.0
#define ASCII_FIRST 0.0
#define EDGE_FIRST 16.0
#define BLOCK_FIRST 20.0
#define RAIN_FIRST 25.0
#define RAIN_COUNT 64.0

sampler_state linear_clamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float luma(float3 c)
{
	return dot(c, float3(0.2126, 0.7152, 0.0722));
}

float hash(float2 p)
{
	return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

// Average colour of one quadrant of a cell, from 2x2 bilinear taps
float3 quadrant(float2 cell, float2 q)
{
	float3 s = float3(0.0, 0.0, 0.0);
	for (int j = 0; j < 2; j++) {
		for (int i = 0; i < 2; i++) {
			float2 sub = (q * 2.0 + float2(float(i), float(j)) + 0.5) / 4.0;
			s += image.Sample(linear_clamp, (cell + sub) / grid).rgb;
		}
	}
	return s * 0.25;
}

float4 PSAscii(VertData v_in) : TARGET
{
	float2 pos  = v_in.uv * grid;
	float2 cell = floor(pos);
	float2 f    = pos - cell;

	float3 tl = quadrant(cell, float2(0.0, 0.0));
	float3 tr = quadrant(cell, float2(1.0, 0.0));
	float3 bl = quadrant(cell, float2(0.0, 1.0));
	float3 br = quadrant(cell, float2(1.0, 1.0));
	float3 colour = (tl + tr + bl + br) * 0.25;

	float L = saturate((luma(colour) - 0.5) * contrast + 0.5 + brightness);
	L = pow(L, gamma);
	if (invert)
		L = 1.0 - L;

	float idx;
	float value = 1.0;
	float white = 0.0;

	if (mode == 2) {
		// Matrix rain: two drops per column, each with its own speed, trail and phase
		float rain = 0.0;
		float head = 0.0;
		for (int k = 0; k < 2; k++) {
			float h1 = hash(float2(cell.x, 7.0 + float(k) * 13.0));
			float h2 = hash(float2(cell.x, 3.0 + float(k) * 29.0));
			float speed = 8.0 + 16.0 * h1;                 // cells per second
			float trail = 6.0 + 20.0 * h2;
			float cycle = grid.y + trail + grid.y * h2;    // includes a gap off screen
			float d = fmod(elapsed * speed + h2 * 997.0, cycle) - cell.y;
			if (d >= 0.0 && d < trail)
				rain = max(rain, 1.0 - d / trail);
			if (d >= 0.0 && d < 1.0)
				head = 1.0;
		}
		// Each cell's glyph changes at its own pace; the head changes fast
		float rate = 0.3 + 2.5 * hash(cell + 17.0) + head * 20.0;
		float g = floor(hash(cell + floor(elapsed * rate) * 0.731) * RAIN_COUNT);
		idx = RAIN_FIRST + min(g, RAIN_COUNT - 1.0);
		value = saturate(pow(L, 1.2) * (0.22 + 0.78 * rain) * 1.4);
		white = (L > 0.15) ? head : 0.0;
	} else if (mode == 1) {
		idx = BLOCK_FIRST + min(floor(L * 5.0), 4.0);
	} else {
		idx = ASCII_FIRST + min(floor(L * 16.0), 15.0);
		if (edges) {
			float gx = (luma(tr) + luma(br)) - (luma(tl) + luma(bl));
			float gy = (luma(bl) + luma(br)) - (luma(tl) + luma(tr));
			if (sqrt(gx * gx + gy * gy) * contrast > edge_threshold) {
				// gradient angle 0/45/90/135 degrees -> | / - \ (y points down)
				float a = atan2(gy, gx) * 57.29578 + 180.0;
				float bin = fmod(floor(a / 45.0 + 0.5), 4.0);
				idx = EDGE_FIRST + bin;
			}
		}
	}

	float2 auv = float2((idx + clamp(f.x, 0.02, 0.98)) / GLYPHS, f.y);
	float ink = atlas.Sample(linear_clamp, auv).r;

	float3 c;
	if (source_colour) {
		// Full-brightness version of the cell colour: the glyph's ink already shows brightness
		float m = max(max(colour.r, colour.g), max(colour.b, 0.004));
		c = 0.25 + 0.75 * (colour / m);
	} else {
		c = tint.rgb;
	}
	float3 rgb = c * value;
	rgb = lerp(rgb, float3(1.0, 1.0, 1.0) * clamp(value, 0.5, 1.0), white);

	// Premultiplied alpha (the filter draws with ONE, INVSRCALPHA blending)
	float a = saturate(ink + bg.a * (1.0 - ink));
	return float4(rgb * ink + bg.rgb * bg.a * (1.0 - ink), a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSAscii(v_in);
	}
}
